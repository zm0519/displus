        0x10)
    f.pdu_status_dti                     = ProtoField.uint8("displus.pdustatus.dti", "爆炸类型指示器 DTI", base.HEX, ST_DTI,
        0x30)
    f.pdu_status_rai                     = ProtoField.uint8("displus.pdustatus.rai", "无线电挂接指示器 RAI", base.HEX, ST_RAI,
        0x30)
    f.pdu_status_iai                     = ProtoField.uint8("displus.pdustatus.iai", "内话挂接指示器 IAI", base.HEX, ST_IAI,
        0x30)
    f.pdu_status_ism                     = ProtoField.uint8("displus.pdustatus.ism", "IFF仿真模式 ISM", base.HEX, ST_ISM,
        0x10)
    f.pdu_status_aii                     = ProtoField.uint8("displus.pdustatus.aii", "主动询问指示器 AII", base.HEX, ST_AII,
        0x20)
    f.pdu_status_raw                     = ProtoField.uint8("displus.pdustatus.field",
        "未实现位 (not implemented for this PDU type)", base.HEX)

    ---------------------------------------------------------------- 头部字段定义
    f.version                            = ProtoField.uint8("displus.protocol_version", "协议版本 (Proto version)", base.DEC,
        VERSION)
    f.exercise                           = ProtoField.uint8("displus.exercise_id", "演练ID (Exercise ID)", base.DEC)
    f.pdu_type                           = ProtoField.uint8("displus.pdu_type", "PDU类型 (PDU type)", base.DEC, PDU_TYPE)
    f.family                             = ProtoField.uint8("displus.protocol_family", "协议族 (Proto Family)", base.DEC,
        FAMILY)
    f.timestamp                          = ProtoField.string("displus.timestamp", "时间戳 (Timestamp)")
    f.pdu_length                         = ProtoField.uint16("displus.pdu_length", "PDU长度 (PDU Length)", base.DEC)
    f.hdr_pad16                          = ProtoField.uint16("displus.hdr_pad16", "填充 (Padding)", base.HEX)
    f.hdr_pad8                           = ProtoField.uint8("displus.hdr_pad8", "填充 (Padding)", base.HEX)

    C.PDU_TYPE_TBL                       = PDU_TYPE
    C.FAMILY_TBL                         = FAMILY
    C.FORCE_TBL                          = FORCE
    C.KIND_TBL                           = KIND
    C.DOMAIN_TBL                         = DOMAIN
    C.VERSION_TBL                        = VERSION

    ---------------------------------------------------------------- PDU 状态位解析
    local function add_pdu_status(st, tvb, off, pdu_type)
        if pdu_type == 1 or pdu_type == 23 or pdu_type == 24
            or pdu_type == 41 or pdu_type == 67 then
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
            st:add(f.pdu_status_tei, tvb(off, 1))
        elseif pdu_type == 2 then
            st:add(f.pdu_status_fti, tvb(off, 1))
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
        elseif pdu_type == 3 then
            st:add(f.pdu_status_dti, tvb(off, 1))
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
        elseif (pdu_type >= 4 and pdu_type <= 22)
            or (pdu_type >= 29 and pdu_type <= 30)
            or (pdu_type >= 33 and pdu_type <= 40)
            or (pdu_type >= 42 and pdu_type <= 66)
            or (pdu_type >= 68 and pdu_type <= 71) then
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
        elseif pdu_type >= 25 and pdu_type <= 27 then
            st:add(f.pdu_status_rai, tvb(off, 1))
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
            st:add(f.pdu_status_tei, tvb(off, 1))
        elseif pdu_type == 28 then
            -- IFF:AII + ISM + CEI + LVC + TEI
            st:add(f.pdu_status_aii, tvb(off, 1))
            st:add(f.pdu_status_ism, tvb(off, 1))
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
            st:add(f.pdu_status_tei, tvb(off, 1))
        elseif pdu_type == 31 or pdu_type == 32 then
            -- 内话信号/控制:IAI + CEI + LVC + TEI
            st:add(f.pdu_status_iai, tvb(off, 1))
            st:add(f.pdu_status_cei, tvb(off, 1))
            st:add(f.pdu_status_lvc, tvb(off, 1))
            st:add(f.pdu_status_tei, tvb(off, 1))
        elseif pdu_type == 72 then
            -- 属性:仅 LVC
            st:add(f.pdu_status_lvc, tvb(off, 1))
        else
            st:add(f.pdu_status_raw, tvb(off, 1))
        end
    end
    C.add_pdu_status = add_pdu_status

    ---------------------------------------------------------------- 12 字节公共头
    function C.dissect_header(tvb, root)
        local hdr = root:add(tvb(0, 12), "头部 (Header)")
        local version = tvb(0, 1):uint()
        local pdu_type = tvb(2, 1):uint()
        hdr:add(f.version, tvb(0, 1))
        hdr:add(f.exercise, tvb(1, 1))
        hdr:add(f.pdu_type, tvb(2, 1))
        hdr:add(f.family, tvb(3, 1))
        hdr:add(f.timestamp, tvb(4, 4), C.ts_text(tvb, 4))
        hdr:add(f.pdu_length, tvb(8, 2))
        if version < 7 then
            hdr:add(f.hdr_pad16, tvb(10, 2))
        else
            local st = hdr:add(f.pdu_status, tvb(10, 1))
            add_pdu_status(st, tvb, 10, pdu_type)
            hdr:add(f.hdr_pad8, tvb(11, 1))
        end
        -- 三向长度自检之一:头部声明长度 vs 实际长度
        local declared = tvb(8, 2):uint()
        if declared ~= tvb:len() then
            hdr:add(tvb(8, 2),
                string.format("[长度] 头部声明 %d 字节,实际 %d 字节", declared, tvb:len()))
        end
        return hdr
    end
end
