-- entity/state.luamod — 实体状态 PDU(PDU 1,实体信息族)
-- Copyright (C) 2026 zhenming(振茗)
-- SPDX-License-Identifier: GPL-2.0-or-later

return function(C)
    local f = C.proto.fields

    ---------------------------------------------------------------- 字段定义
    -- 实体标记 [UID 45 字符集]
    local V_CHARSET = {
        [0] = "未用 Unused",
        [1] = "ASCII",
        [2] = "美国陆军标记 Army Marking (CCTT)",
        [3] = "数字 V 形 Digit Chevron",
        [4] = "UTF-8",
    }
    f.marking_charset = ProtoField.uint8("displus.entity_marking_character_set",
        "字符集 (Character Set)", base.DEC, V_CHARSET)
    f.marking = ProtoField.string("displus.entity_marking", "实体标记 (Entity Marking)")

    ---------------------------------------------------------------- 能力位表(v37 [UID 450-462])
    local YESNO = { "是 Yes", "否 No" }
    local function cbf(abbrev, name, mask)
        local fld = ProtoField.bool(abbrev, name, 32, YESNO, mask)
        f[abbrev] = fld
        return fld
    end
    local cap_ammo     = cbf("displus.cap.ammunition_supply",  "弹药补给 (Ammunition Supply)", 0x001)
    local cap_fuel     = cbf("displus.cap.fuel_supply",        "油料补给 (Fuel Supply)", 0x002)
    local cap_recovery = cbf("displus.cap.recovery",           "抢救 (Recovery)", 0x004)
    local cap_repair   = cbf("displus.cap.repair",             "维修 (Repair)", 0x008)
    local cap_adsb     = cbf("displus.cap.adsb",               "ADS-B (Automatic Dependent Surveillance-Broadcast)", 0x010)
    local cap_carrier  = cbf("displus.cap.sling_load_carrier", "吊挂载荷承载 (Sling Load Carrier)", 0x020)
    local cap_sling    = cbf("displus.cap.sling_loadable",     "可吊挂运输 (Sling Load Transportable)", 0x040)
    local cap_ied      = cbf("displus.cap.ied_present",        "存在简易爆炸装置(IED)指示 (IED Present)", 0x080)
    local cap_group    = cbf("displus.cap.groupable",          "可编组 (Groupable)", 0x100)
    local cap_laircm   = cbf("displus.cap.laircm",             "大型飞机红外对抗 (LAIRCM)", 0x200)

    -- 各种类/域适用的位(§17.6.3-17.6.15;无线电/消耗性器材无定义位,显示裸值)
    local CAP_GROUND = { cap_ammo, cap_fuel, cap_recovery, cap_repair,
                         cap_sling, cap_ied, cap_group }             -- 陆域
    local CAP_TBL = {
        ["1:1"] = CAP_GROUND,                                        -- [UID 450]
        ["1:2"] = { cap_ammo, cap_fuel, cap_recovery, cap_repair, cap_adsb,
                     cap_carrier, cap_sling, cap_ied, cap_group, cap_laircm }, -- [UID 451] 空域
        ["1:3"] = CAP_GROUND,                                        -- [UID 452] 水面
        ["1:4"] = CAP_GROUND,                                        -- [UID 453] 水下
        ["1:5"] = { cap_ammo, cap_fuel, cap_recovery, cap_repair },  -- [UID 454] 太空
        ["2"]   = { cap_ied },                                       -- [UID 455] 弹药
        ["3"]   = { cap_ammo, cap_fuel, cap_recovery, cap_repair },  -- [UID 456] 生命体
        ["4"]   = { cap_sling, cap_ied },                            -- [UID 458] 文化地物
        ["5"]   = { cap_ammo, cap_fuel, cap_sling, cap_ied },        -- [UID 459] 补给
        ["6"]   = { cap_ied },                                       -- [UID 457] 环境实体
        ["9"]   = { cap_sling, cap_ied, cap_group },                 -- [UID 462] 传感器/发射器
    }
    f.capabilities = ProtoField.uint32("displus.capabilities",
        "能力 (Capabilities)", base.HEX)

    -- 能力节点:按 kind/domain 查表位解码,无表(其他/无线电/消耗性器材)仅裸值
    local function add_capabilities(t, tvb, off, kind, domain)
        local node = t:add(f.capabilities, tvb(off, 4))
        local tbl = kind == 1
            and CAP_TBL[string.format("1:%d", domain)]
            or  CAP_TBL[tostring(kind)]
        if tbl then
            for _, fl in ipairs(tbl) do node:add(fl, tvb(off, 4)) end
        end
        return off + 4
    end

    ---------------------------------------------------------------- EntityState(PDU 1)
    -- 布局:EntityID(6) force(1) numVP(1) EntityType(8) AltType(8) Vel(12)
    --       Loc(24) Ori(12) Appearance(4) DR(40) Marking(12) Cap(4) VP(16N)
    local function dissect_entity_state(tvb, body, off, pinfo)
        if not C.need(tvb, off, 26, body) then return off end
        local site, app, entity, kind, domain
        off, site, app, entity = C.add_entity_id(body, tvb, off, "实体ID (Entity ID)")
        body:add(f.force_id, tvb(off, 1)); off = off + 1
        local nvp = tvb(off, 1):uint()
        body:add(f.num_art_params, tvb(off, 1)); off = off + 1
        off, kind, domain = C.add_entity_type(body, tvb, off, "实体类型 (Entity Type)")
        -- 记录上下文:三元组键 + 帧号历史
        C.remember_ctx(site, app, entity, kind, domain, pinfo.number)
        off = C.add_entity_type(body, tvb, off, "备选实体类型 (Alternative Entity Type)")

        local v = body:add(tvb(off, 12), "线速度 (Entity Linear Velocity)")
        v:add(f.vel_x, tvb(off, 4)); v:add(f.vel_y, tvb(off + 4, 4)); v:add(f.vel_z, tvb(off + 8, 4))
        off = off + 12

        local l = body:add(tvb(off, 24), "位置 (Entity Location)")
        l:add(f.loc_x, tvb(off, 8)); l:add(f.loc_y, tvb(off + 8, 8)); l:add(f.loc_z, tvb(off + 16, 8))
        off = off + 24

        local o = body:add(tvb(off, 12), "姿态 (Entity Orientation)")
        o:add(f.ori_psi, tvb(off, 4)); o:add(f.ori_theta, tvb(off + 4, 4)); o:add(f.ori_phi, tvb(off + 8, 4))
        off = off + 12

        off = C.add_appearance(body, tvb, off, kind, domain)

        local dr = body:add(tvb(off, 40), "航位推算参数 (Dead Reckoning Parameters)")
        dr:add(f.dr_algorithm, tvb(off, 1)); off = off + 1
        dr:add(f.dr_other, tvb(off, 15)); off = off + 15
        local a = dr:add(tvb(off, 12), "线加速度 (Entity Linear Acceleration)")
        a:add(f.acc_x, tvb(off, 4)); a:add(f.acc_y, tvb(off + 4, 4)); a:add(f.acc_z, tvb(off + 8, 4))
        off = off + 12
        local w = dr:add(tvb(off, 12), "角速度 (Entity Angular Velocity)")
        w:add(f.av_x, tvb(off, 4)); w:add(f.av_y, tvb(off + 4, 4)); w:add(f.av_z, tvb(off + 8, 4))
        off = off + 12

        -- 实体标记
        if C.need(tvb, off, 12, body) then
            local mk = body:add(tvb(off, 12), "实体标记 (Entity Marking)")
            mk:add(f.marking_charset, tvb(off, 1))
            off = off + 1
            mk:add(f.marking, tvb(off, 11))
            off = off + 11
        end

        off = add_capabilities(body, tvb, off, kind, domain)

        if nvp > C.MAX_RECORDS then
            body:add(tvb(), string.format("变参数数量 %d 超上限,仅解析前 %d 条", nvp, C.MAX_RECORDS))
            nvp = C.MAX_RECORDS
        end
        off = C.add_variable_params(body, tvb, off, nvp)
        return off
    end

    C.register(1, dissect_entity_state, "实体状态 Entity State")
end
