-- 内容:速度/位置/姿态/外观/DR 字段、质量字段,Appearance 位表与渲染。

return function(C)
    local f          = C.proto.fields

    ---------------------------------------------------------------- 族内共享字段
    f.vel_x          = ProtoField.float("displus.entity_linear_velocity_x", "X (Velocity)")
    f.vel_y          = ProtoField.float("displus.entity_linear_velocity_y", "Y (Velocity)")
    f.vel_z          = ProtoField.float("displus.entity_linear_velocity_z", "Z (Velocity)")
    f.loc_x          = ProtoField.double("displus.entity_location_x", "X (Location)")
    f.loc_y          = ProtoField.double("displus.entity_location_y", "Y (Location)")
    f.loc_z          = ProtoField.double("displus.entity_location_z", "Z (Location)")
    f.ori_psi        = ProtoField.float("displus.entity_orientation_psi", "偏航 psi")
    f.ori_theta      = ProtoField.float("displus.entity_orientation_theta", "俯仰 theta")
    f.ori_phi        = ProtoField.float("displus.entity_orientation_phi", "横滚 phi")
    f.appearance     = ProtoField.uint32("displus.entity_appearance", "实体外观 (Appearance)", base.HEX)
    -- 航位推算参数 [UID 44]
    local V_DR       = {
        [0] = "其他 Other",
        [1] = "静态——非运动实体 Static - Non-moving Entity",
        [2] = "DRM(FPW)——匀速/低加速度直线运动实体",
        [3] = "DRM(RPW)——匀速/低加速度直线运动实体,含外推取向",
        [4] = "DRM(RVW)——高速或机动实体,含外推取向",
        [5] = "DRM(FVW)——高速或机动实体",
        [6] = "DRM(FPB)——同 FPW,但用机体坐标",
        [7] = "DRM(RPB)——同 RPW,但用机体坐标",
        [8] = "DRM(RVB)——同 RVW,但用机体坐标",
        [9] = "DRM(FVB)——同 FVW,但用机体坐标",
        [10] = "抛物线/圆弧组合(CPC) Combined Parabolic/Circular (CPC)",
    }
    f.dr_algorithm   = ProtoField.uint8("displus.dr_algorithm",
        "算法 (Dead Reckoning Algorithm)", base.DEC, V_DR)
    f.dr_other       = ProtoField.bytes("displus.dr_other_parameters",
        "其他参数 (Other Parameters)")
    f.acc_x          = ProtoField.float("displus.entity_linear_acceleration_x", "X (Acceleration)")
    f.acc_y          = ProtoField.float("displus.entity_linear_acceleration_y", "Y (Acceleration)")
    f.acc_z          = ProtoField.float("displus.entity_linear_acceleration_z", "Z (Acceleration)")
    f.av_x           = ProtoField.float("displus.entity_angular_velocity_x", "X (Angular Velocity)")
    f.av_y           = ProtoField.float("displus.entity_angular_velocity_y", "Y (Angular Velocity)")
    f.av_z           = ProtoField.float("displus.entity_angular_velocity_z", "Z (Angular Velocity)")
    -- 质量(碰撞 4 / 碰撞-弹性 66 共用)
    f.collision_mass = ProtoField.float("displus.collision_mass", "质量 (Mass) kg")

    local ONOFF      = { "开 On", "关 Off" }
    local function bf(abbrev, name, mask, tf)
        local fld = ProtoField.bool(abbrev, name, 32, tf or ONOFF, mask)
        f[abbrev] = fld
        return fld
    end
    local function ef(abbrev, name, mask, vals)
        local fld = ProtoField.uint32(abbrev, name, base.DEC, vals, mask)
        f[abbrev] = fld
        return fld
    end

    local V_DAMAGE       = {
        [0] = "无损伤 No Damage",
        [1] = "轻度损伤 Slight Damage",
        [2] = "中度损伤 Moderate Damage",
        [3] = "被毁 Destroyed"
    } -- [UID 379]
    local V_TRAIL        = {
        [0] = "无 None",
        [1] = "小 Small",
        [2] = "中 Medium",
        [3] = "大 Large"
    } -- [UID 381]
    local V_CAMO         = {
        [0] = "荒漠迷彩 Desert Camouflage",
        [1] = "冬季迷彩 Winter Camouflage",
        [2] = "森林迷彩 Forest Camouflage",
        [3] = "其他 Other"
    } -- [UID 384]
    local V_STATE        = { [0] = "活动 Active", [1] = "停用 Deactivated" } -- [UID 386]
