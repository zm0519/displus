    -- kind+domain -> 位表(kind=0 其他/未知无表,显示裸 u32)
    local APPEARANCE_TBL = {
        ["1:1"] = LAND,
        ["1:2"] = AIR,
        ["1:3"] = SURFACE,
        ["1:4"] = SUBSURFACE,
        ["1:5"] = SPACE,
        ["2"] = MUNITION,
        ["3"] = LIFE,
        ["4"] = CULTURAL,
        ["5"] = SUPPLY,
        ["6"] = ENVIRONMENTAL,
        ["7"] = RADIO,
        ["8"] = EXPENDABLE,
        ["9"] = SENSOR,
    }

    -- 导出供 67 实体状态更新复用(按跨包上下文选位表)
    function C.add_appearance(t, tvb, off, kind, domain)
        local app = t:add(f.appearance, tvb(off, 4))
        local tbl = kind == 1
            and APPEARANCE_TBL[string.format("1:%d", domain)]
            or APPEARANCE_TBL[tostring(kind)]
        if tbl then
            for _, fl in ipairs(tbl) do app:add(fl, tvb(off, 4)) end
        end
        return off + 4
    end
end
