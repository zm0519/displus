-- emission/underwater.luamod — 水声 PDU(PDU 29,分布发射再生族)
-- Copyright (C) 2026 zhenming(振茗)
-- SPDX-License-Identifier: GPL-2.0-or-later
-- 布局:Emitting(6) EventID(6) state(1) pad8(1) passive_param(2) propulsion(1)
--       轴数(1) APA数(1) 声发射系统数(1) + 轴×8B{当前/指令转速(u16)+变化率(f32)}
--       + APA×4B{索引(u16)+值(u16)}
--       + 系统数×{len(1) 波束数(1) pad16(2) 名称/功能/编号(4) Location(12)}
--       + 总波束数×{len(1) num(1) pad16(2) 参数索引(2) 扫描(2) 方位/俯仰 中心与宽(16)}
-- 声学发射器名称 [UID 144]、系统功能 [UID 145]、扫描模式 [UID 147](enums_data)

return function(C)
    local f            = C.proto.fields

    f.ua_passive_param = ProtoField.uint16("displus.passive_parameter_index",
        "被动参数索引 (Passive Parameter Index)", base.DEC)
    f.ua_propulsion    = ProtoField.uint8("displus.propulsion_plant_config",
        "推进装置配置 (Propulsion Plant Configuration)", base.DEC)
    f.ua_num_shafts    = ProtoField.uint8("displus.num_shafts", "轴数 (Number of Shafts)", base.DEC)
    f.ua_num_apas      = ProtoField.uint8("displus.num_apas", "APA 数 (Number of APAs)", base.DEC)
    f.ua_num_emitters  = ProtoField.uint8("displus.num_ua_emitter_systems",
        "声发射系统数 (Number of Acoustic Emitter Systems)", base.DEC)
    f.shaft_rpm_cur    = ProtoField.uint16("displus.shaft_rpm_current", "当前转速 (Current Shaft RPM)", base.DEC)
    f.shaft_rpm_ord    = ProtoField.uint16("displus.shaft_rpm_ordered", "指令转速 (Ordered Shaft RPM)", base.DEC)
    f.shaft_rpm_rate   = ProtoField.float("displus.shaft_rpm_change_rate", "转速变化率 (RPM Change Rate)", base.DEC)
    f.apa_index        = ProtoField.uint16("displus.apas_parameter_index", "APA 参数索引 (APA Parameter Index)", base.DEC)
    f.apa_value        = ProtoField.uint16("displus.apas_value", "APA 值 (APA Value)", base.DEC)
    f.ua_em_data_len   = ProtoField.uint8("displus.ua_emitter_data_length", "数据长度 (Emitter Data Length)", base.DEC)
    f.ua_num_beams     = ProtoField.uint8("displus.ua_num_beams", "波束数 (Number of Beams)", base.DEC)
    f.ua_em_name       = ProtoField.uint16("displus.ua_emission_name", "发射名称 (Acoustic Emission Name)",
        base.DEC, C.ENUMS.UA_EMITTER_NAME)
    f.ua_em_func       = ProtoField.uint8("displus.ua_emission_function", "功能 (Acoustic Emission Function)",
        base.DEC, C.ENUMS.UA_EMIT_FUNCTION)
    f.ua_em_id         = ProtoField.uint8("displus.ua_emission_id_number", "编号 (Emitter ID Number)", base.DEC)
    f.ua_loc_x         = ProtoField.float("displus.ua_location_x", "X (Location wrt Entity)")
    f.ua_loc_y         = ProtoField.float("displus.ua_location_y", "Y (Location wrt Entity)")
    f.ua_loc_z         = ProtoField.float("displus.ua_location_z", "Z (Location wrt Entity)")
    f.ua_beam_data_len = ProtoField.uint8("displus.ua_beam_data_length", "波束数据长度 (Beam Data Length)", base.DEC)
    f.ua_beam_id       = ProtoField.uint8("displus.ua_beam_id_number", "波束编号 (Beam ID Number)", base.DEC)
    f.ua_param_idx     = ProtoField.uint16("displus.ua_beam_active_emission_parameter_index",
        "主动发射参数索引 (Active Emission Parameter Index)", base.DEC)
    f.ua_scan_pattern  = ProtoField.uint16("displus.ua_beam_scan_pattern", "扫描图 (Scan Pattern)",
        base.DEC, C.ENUMS.SCAN_PATTERN)
    f.ua_az_c          = ProtoField.float("displus.ua_beam_center_azimuth", "方位角中心 (Center Azimuth) rad")
    f.ua_az_w          = ProtoField.float("displus.ua_beam_azimuthal_beamwidth", "方位波束宽 (Azimuthal Beamwidth) rad")
    f.ua_de_c          = ProtoField.float("displus.ua_beam_center_de", "俯仰/角中心 (Center DE) rad")
    f.ua_de_w          = ProtoField.float("displus.ua_beam_de_beamwidth", "俯仰波束宽 (DE Beamwidth) rad")

    local function dissect_underwater(tvb, body, off, pinfo)
        if not C.need(tvb, off, 14, body) then return off end
        off = C.add_entity_id(body, tvb, off, "发射实体ID (Emitting Entity ID)")
        off = C.add_event_id(body, tvb, off, "事件ID (Event ID)")
        body:add(f.em_state_update, tvb(off, 1)); off = off + 1
        body:add(f.pad8, tvb(off, 1)); off = off + 1
        body:add(f.ua_passive_param, tvb(off, 2)); off = off + 2
        body:add(f.ua_propulsion, tvb(off, 1)); off = off + 1
        local nshafts = tvb(off, 1):uint()
        body:add(f.ua_num_shafts, tvb(off, 1)); off = off + 1
        local napas = tvb(off, 1):uint()
        body:add(f.ua_num_apas, tvb(off, 1)); off = off + 1
        local nemitters = tvb(off, 1):uint()
        body:add(f.ua_num_emitters, tvb(off, 1)); off = off + 1
        local nbeams_total = 0
        for i = 1, math.min(nshafts, C.MAX_RECORDS) do
            if not C.need(tvb, off, 8, body) then return off end
            local s = body:add(tvb(off, 8), string.format("轴 (Shaft) [%d/%d]", i, nshafts))
            s:add(f.shaft_rpm_cur, tvb(off, 2))
            s:add(f.shaft_rpm_ord, tvb(off + 2, 2))
            s:add(f.shaft_rpm_rate, tvb(off + 4, 4))
            off = off + 8
        end
        for i = 1, math.min(napas, C.MAX_RECORDS) do
            if not C.need(tvb, off, 4, body) then return off end
            local a = body:add(tvb(off, 4), string.format("APA [%d/%d]", i, napas))
            a:add(f.apa_index, tvb(off, 2))
            a:add(f.apa_value, tvb(off + 2, 2))
            off = off + 4
        end
        local emitters = {}
        for i = 1, math.min(nemitters, C.MAX_RECORDS) do
            if not C.need(tvb, off, 20, body) then return off end
            local e = body:add(tvb(off, 20), string.format("声发射系统 [%d/%d]", i, nemitters))
            e:add(f.ua_em_data_len, tvb(off, 1)); off = off + 1
            nbeams_total = nbeams_total + tvb(off, 1):uint()
            e:add(f.ua_num_beams, tvb(off, 1)); off = off + 1
            e:add(f.pad16, tvb(off, 2)); off = off + 2
            local es = e:add(tvb(off, 4), "声发射系统 (Acoustic Emitter System)")
            es:add(f.ua_em_name, tvb(off, 2))
            es:add(f.ua_em_func, tvb(off + 2, 1))
            es:add(f.ua_em_id, tvb(off + 3, 1))
            off = off + 4
            local loc = e:add(tvb(off, 12), "位置(相对实体) (Location wrt Entity)")
            loc:add(f.ua_loc_x, tvb(off, 4)); loc:add(f.ua_loc_y, tvb(off + 4, 4)); loc:add(f.ua_loc_z, tvb(off + 8, 4))
            off = off + 12
        end
        for i = 1, math.min(nbeams_total, C.MAX_RECORDS * 8) do
            if not C.need(tvb, off, 24, body) then return off end
            local b = body:add(tvb(off, 24), string.format("波束 [%d/%d]", i, nbeams_total))
            b:add(f.ua_beam_data_len, tvb(off, 1)); off = off + 1
            b:add(f.ua_beam_id, tvb(off, 1)); off = off + 1
            b:add(f.pad16, tvb(off, 2)); off = off + 2
            local fd = b:add(tvb(off, 20), "基础数据参数 (Fundamental Data Parameters)")
            fd:add(f.ua_param_idx, tvb(off, 2)); fd:add(f.ua_scan_pattern, tvb(off + 2, 2))
            fd:add(f.ua_az_c, tvb(off + 4, 4)); fd:add(f.ua_az_w, tvb(off + 8, 4))
            fd:add(f.ua_de_c, tvb(off + 12, 4)); fd:add(f.ua_de_w, tvb(off + 16, 4))
            off = off + 20
        end
        return off
    end
    C.register(29, dissect_underwater, "水声 Underwater Acoustic")
end
